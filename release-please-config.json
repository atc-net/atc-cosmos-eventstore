{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "552ac338d169f743499cf720da1f2c8a022a7cf3",
  "include-v-in-tag": true,
  "include-component-in-tag": true,
  "tag-separator": "@",
  "separate-pull-requests": false,
  "pull-request-header": ":robot: Preparing to release next version",
  "pull-request-footer": "This pull request was generated by release-please.",
  "pull-request-title-pattern": "chore: release version ${version}",
  "plugins": [
    {
      "type": "linked-versions",
      "groupName": "atc-cosmos-eventstore",
      "components": [
        "Atc.Cosmos.EventStore",
        "Atc.Cosmos.EventStore.Cqrs"
      ]
    }
  ],
  "packages": {
    "src/Atc.Cosmos.EventStore": {
      "component": "Atc.Cosmos.EventStore",
      "release-type": "simple",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        "Directory.Build.props"
      ]
    },
    "src/Atc.Cosmos.EventStore.Cqrs": {
      "component": "Atc.Cosmos.EventStore.Cqrs",
      "release-type": "simple",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        "Directory.Build.props"
      ]
    }
  },
  "changelog-sections": [
    {
      "type": "feat",
      "section": "New features"
    },
    {
      "type": "fix",
      "scope": "deps",
      "section": "Upgrades"
    },
    {
      "type": "fix",
      "section": "Bug fixes"
    },
    {
      "type": "perf",
      "section": "Performance improvements"
    },
    {
      "type": "revert",
      "section": "Reverts"
    }
  ]
}
